# ========================================
# Google AI Configuration
# ========================================
GOOGLE_API_KEY="your-google-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"

# ========================================
# Tavily Search API (Web Search)
# ========================================
TAVILY_API_KEY="your-tavily-api-key-here"

# ========================================
# SerpApi (live Google Flights and Google Hotels)
# Leave empty to use clearly labelled fixture results.
# ========================================
SERPAPI_API_KEY="your-serpapi-key-here"

# ========================================
# OpenWeatherMap API
# ========================================
OPENWEATHERMAP_API_KEY="your-openweathermap-key-here"

# ========================================
# Application Settings
# ========================================
APP_NAME="Travel AI Assistant"
APP_VERSION="1.0.0"
DEBUG=True

# ========================================
# Server Settings
# ========================================
HOST=0.0.0.0
PORT=8000

# ========================================
# Durable LangGraph checkpoints (SQLite)
# ========================================
CHECKPOINT_DB_PATH="data/langgraph_checkpoints.sqlite"

# Session persistence: use "sqlserver" locally or "sqlite" for a Render demo.
SESSION_STORE_BACKEND="sqlserver"
SESSION_SQLITE_PATH="data/travel_sessions.sqlite"

# ========================================
# SQL Server Configuration
# ========================================
SQL_SERVER_HOST="your-sql-server-host"
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE="Travel_AI_ASSISTANT"
SQL_SERVER_USER="sa"
SQL_SERVER_PASSWORD="your-strong-password"
